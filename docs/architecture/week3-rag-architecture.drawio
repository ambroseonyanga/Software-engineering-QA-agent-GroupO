        <mxCell id="e5" value="No matches" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="retrieve" target="empty">
          <mxGeometry as="geometry" relative="1" />
